{
  "Framework": {
    "Environment": "Production",
    "Culture": "en-US",
    "Timeouts": {
      "GlobalTimeoutSeconds": 60,
      "NavigationTimeoutSeconds": 60,
      "ActionTimeoutSeconds": 30
    },
    "Evidence": {
      "Screenshot": "PreAndPost",
      "Video": "onFailure",
      "Trace": true,
      "StoragePath": "evidence"
    },
    "Reporting": {
      "HistoryEnabled": true,
      "HistoryDirectory": "history",
      "HistoryReadLimit": 50,
      "AllureHistory": "Cumulative",
      "KeepPastRuns": 20,
      "GenerateReport": "OnceAtEnd",
      "ServeReport": false,
      "ReportPort": 56789
    },
    "Parallelism": {
      "MaxWorkers": 8,
      "EnableSharding": true
    },
    "Observability": {
      "Mode": "Direct",
      "EnableMetrics": true,
      "EnableTracing": true,
      "PrometheusEndpoint": "http://prometheus:9090",
      "GrafanaEndpoint": "http://grafana:3000",
      "OtlpEndpoint": "http://otel-collector:4317",
      "ExportIntervalSeconds": 30,
      "AutoOpenGrafana": false
    }
  },
  "Api": {
    "BaseUrl": "https://jsonplaceholder.typicode.com",
    "TimeoutSeconds": 60
  },
  "Device": {
    "Browser": "Chromium",
    "Headless": false,
    "ViewportWidth": 1920,
    "ViewportHeight": 1080
  },
  "Allure": {
    "ResultsDirectory": "allure-results",
    "ProjectName": "Production Tests",
    "AutoOpenReport": true,
    "ReportPort": 56789
  }
}
