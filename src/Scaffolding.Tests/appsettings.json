{
  "Framework": {
    "Environment": "Development",
    "Culture": "en-US",
    "Headless": true,
    "Timeouts": {
      "GlobalTimeoutSeconds": 30,
      "NavigationTimeoutSeconds": 30,
      "ActionTimeoutSeconds": 10
    },
    "Evidence": {
      "Screenshot": "PreAndPost",
      "Video": "OnFailure",
      "Trace": true,
      "StoragePath": "./evidence"
    },
    "Parallelism": {
      "MaxWorkers": 4,
      "EnableSharding": false
    }
  },
  "Device": {
    "Browser": "Chromium",
    "Headless": true,
    "Viewport": [
      1920,
      1080
    ]
  },
  "Allure": {
    "ResultsDirectory": "allure-results",
    "ProjectName": "Scaffolding Tests",
    "AutoOpenReport": false,
    "ReportPort": 56789
  }
}
