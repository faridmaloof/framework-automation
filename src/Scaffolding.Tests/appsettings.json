{
  "Framework": {
    "Environment": "Development",
    "Culture": "en-US",
    "Timeouts": {
      "GlobalTimeoutSeconds": 30,
      "NavigationTimeoutSeconds": 30,
      "ActionTimeoutSeconds": 10
    },
    "Evidence": {
      "Screenshot": "PreAndPost",
      "Video": "onFailure",
      "Trace": false,
      "StoragePath": "evidence"
    },
    "Reporting": {
      "HistoryEnabled": true,
      "HistoryDirectory": "history",
      "HistoryReadLimit": 50,
      "AllureHistory": "Cumulative",
      "KeepPastRuns": 20,
      "GenerateReport": "OnceAtEnd",
      "ServeReport": false,
      "ReportPort": 56789
    },
    "Parallelism": {
      "MaxWorkers": 4,
      "EnableSharding": false
    },
    "Observability": {
      "Mode": "Console",
      "EnableMetrics": true,
      "EnableTracing": false,
      "PrometheusEndpoint": "http://localhost:9090",
      "GrafanaEndpoint": "http://localhost:3000",
      "OtlpEndpoint": "http://localhost:4317",
      "ExportIntervalSeconds": 60,
      "AutoOpenGrafana": false
    }
  },
  "Api": {
    "BaseUrl": "https://jsonplaceholder.typicode.com",
    "TimeoutSeconds": 30
  },
  "Device": {
    "Browser": "Chromium",
    "Headless": false,
    "ViewportWidth": 1920,
    "ViewportHeight": 1080
  },
  "Allure": {
    "ResultsDirectory": "allure-results",
    "ProjectName": "Scaffolding Tests",
    "AutoOpenReport": true,
    "ReportPort": 56789
  }
}
